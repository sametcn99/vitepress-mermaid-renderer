{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run docs:build",
  "outputDirectory": ".vitepress/dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </openapi.json>; rel=\"service-desc\", </.well-known/ai-catalog.json>; rel=\"describedby\", </guide/getting-started>; rel=\"service-doc\", </.well-known/agent-skills/index.json>; rel=\"describedby\""
